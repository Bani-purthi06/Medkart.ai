\noindent\textit{Class relationship summary (UML notation):}
\begin{itemize}[leftmargin=0.7cm]
    \item User 1--* Prescription (a user uploads many prescriptions)
    \item Prescription 1--* PrescriptionItem (a prescription contains many line items)
    \item PrescriptionItem *--1 Medicine (each item resolves to one canonical medicine)
    \item Medicine 1--* PlatformPrice (one medicine has many platform-specific prices)
    \item PlatformPrice 1--1 PriceAnomaly (each price may have exactly one anomaly assessment)
    \item Medicine *--* DrugInteraction (many-to-many; a medicine can interact with many others)
    \item User 1--* Watchlist *--1 Medicine (a user watches many medicines; a medicine can be watched by many users)
\end{itemize}

