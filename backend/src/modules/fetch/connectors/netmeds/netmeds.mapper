import { RawNetmedsResult } from "./netmeds.scraper";
import { NormalizedPrice } from "../onemg/onemg.mapper";

export function mapNetmedsResult(
  raw: RawNetmedsResult,
  medicineId: number,
  platformId: number
): NormalizedPrice | null {
  if (!raw.price) return null;

  const numericPrice = parseFloat(raw.price.replace(/[^0-9.]/g, ""));
  if (isNaN(numericPrice)) return null;

  return {
    medicineId,
    platformId,
    price: numericPrice,
    discountPct: null,
    stockStatus: true,
    deliveryEta: null,
  };
}
