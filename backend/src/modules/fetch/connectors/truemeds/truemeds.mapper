import { RawTruemedsResult } from "./truemeds.scraper";
import { NormalizedPrice } from "../onemg/onemg.mapper";

export function mapTruemedsResult(
  raw: RawTruemedsResult,
  medicineId: number,
  platformId: number
): NormalizedPrice | null {
  if (!raw.price) return null;

  const numericPrice = parseFloat(raw.price.replace(/[^0-9.]/g, ""));
  if (isNaN(numericPrice)) return null;

  return {
    medicineId,
    platformId,
    price: numericPrice,
    discountPct: null,
    stockStatus: true,
    deliveryEta: null,
  };
}
