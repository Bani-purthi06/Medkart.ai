{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@medcompare/shared-types": ["packages/shared-types/src"],
      "@medcompare/shared-config": ["packages/shared-config/src"],
      "@medcompare/shared-utils": ["packages/shared-utils/src"],
      "@medcompare/*": ["services/*/src"]
    }
  },
  "include": ["packages/**/*", "services/**/*", "*.d.ts"],
  "exclude": ["node_modules", "dist"]
}